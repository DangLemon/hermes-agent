# needed to prevent bad npm that has min-release-age but not exclude
engine-strict=true

min-release-age=14

# body-parser 1.20.8 pulls qs 6.16.0, the patched Express parser chain.
# The package was published 2026-09-08; remove this exception after
# 2026-09-22T10:32Z when it is outside the 14-day publication gate.
min-release-age-exclude[]=body-parser
